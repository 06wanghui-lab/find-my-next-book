# API
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Web
VITE_API_BASE_URL=http://localhost:8000

# Recommendation agent (never commit real values)
GOOGLE_API_KEY=
TAVILY_API_KEY=
AGENT_MODEL=gemini-3.8-flash
AGENT_FALLBACK_MODEL=
AGENT_TEMPERATURE=1.0
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_RETRY_BACKOFF_SECONDS=1.0
AGENT_INITIAL_QUERY_COUNT=2
AGENT_MAX_SEARCH_ATTEMPTS=2
AGENT_MAX_SEARCH_CALLS=3
AGENT_SEARCH_MAX_RESULTS=5
AGENT_MAX_REFERENCE_BOOKS=3
AGENT_MAX_VERIFICATION_CANDIDATES=5
AGENT_MIN_CANDIDATES_FOR_VERIFICATION=3
AGENT_MIN_RECOMMENDATIONS=3
AGENT_MAX_RECOMMENDATIONS=5
AGENT_SESSION_DIR=.novelscout/sessions

